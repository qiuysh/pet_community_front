{
  "name": "pet-community-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec vite",
    "build": "pnpm exec tsc && pnpm exec vite build",
    "preview": "pnpm exec vite preview",
    "lint": "pnpm exec eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "pnpm exec vitest",
    "test:watch": "pnpm exec vitest --watch",
    "test:coverage": "pnpm exec vitest --coverage",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:report": "pnpm exec playwright show-report e2e-report"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "3.12.4",
    "axios": "^1.6.0",
    "crypto-js": "^4.2.0",
    "jsencrypt": "^3.5.4",
    "lucide-react": "^0.454.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.12.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "16.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "24.0.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.14",
    "sass": "^1.99.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
